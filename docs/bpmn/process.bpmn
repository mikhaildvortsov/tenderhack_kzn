<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://tenderhack.kzn/ktru-autofill" exporter="tenderhack_kzn" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_1" name="Автозаполнение характеристик СТЕ (Портал поставщиков)" processRef="P1"/>
    <bpmn:participant id="Part_2" name="Индекс КТРУ / ETL" processRef="P2"/>
    <bpmn:messageFlow id="MF_1" name="Индекс загружается при старте реплик" sourceRef="E_idx" targetRef="T3"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="false">
    <bpmn:laneSet id="LS_P1">
      <bpmn:lane id="L_user" name="Поставщик (пользователь)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ui" name="Веб-интерфейс (React)">
        <bpmn:flowNodeRef>T_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_hshow</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_api" name="Сервис анализа (FastAPI)">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_hint</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Нужно заполнить СТЕ">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_in" name="Ввести описание товара">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F_loop</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="T_send" name="Debounce 400 мс, отправить POST /api/v1/analyze">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="T1" name="Нормализация и исправление ошибок (раскладка, опечатки, числа)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_T1_T2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Определить категорию (одежда / мебель / инструменты)">
      <bpmn:incoming>F_T1_T2</bpmn:incoming>
      <bpmn:outgoing>F_T2_T3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T3" name="Найти кандидатов КТРУ (BM25 + fuzzy)">
      <bpmn:incoming>F_T2_T3</bpmn:incoming>
      <bpmn:outgoing>F_T3_T4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Извлечь характеристики, унифицировать единицы (ОКЕИ)">
      <bpmn:incoming>F_T3_T4</bpmn:incoming>
      <bpmn:outgoing>F_T4_T5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T5" name="Сузить кандидатов по характеристикам">
      <bpmn:incoming>F_T4_T5</bpmn:incoming>
      <bpmn:outgoing>F_T5_T6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T6" name="Валидация: 9 типов ошибок с обоснованием">
      <bpmn:incoming>F_T5_T6</bpmn:incoming>
      <bpmn:outgoing>F_T6_G1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Код однозначен?" default="F_no">
      <bpmn:incoming>F_T6_G1</bpmn:incoming>
      <bpmn:outgoing>F_yes</bpmn:outgoing>
      <bpmn:outgoing>F_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Есть кандидаты?" default="F_g2_no">
      <bpmn:incoming>F_no</bpmn:incoming>
      <bpmn:outgoing>F_g2_yes</bpmn:outgoing>
      <bpmn:outgoing>F_g2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_show" name="Показать код КТРУ и характеристики">
      <bpmn:incoming>F_yes</bpmn:incoming>
      <bpmn:outgoing>F_show_conf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T_confirm" name="Подтвердить / отредактировать характеристики">
      <bpmn:incoming>F_show_conf</bpmn:incoming>
      <bpmn:outgoing>F_conf_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="СТЕ заполнена">
      <bpmn:incoming>F_conf_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_reco" name="Сформировать рекомендации: что уточнить">
      <bpmn:incoming>F_g2_yes</bpmn:incoming>
      <bpmn:outgoing>F_reco_cand</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T_cand" name="Показать кандидатов, воронку и рекомендации">
      <bpmn:incoming>F_reco_cand</bpmn:incoming>
      <bpmn:outgoing>F_cand_fix</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T_fix" name="Дополнить / исправить описание">
      <bpmn:incoming>F_cand_fix</bpmn:incoming>
      <bpmn:incoming>F_hshow_fix</bpmn:incoming>
      <bpmn:outgoing>F_loop</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_hint" name="Сформировать подсказки по исправлению ввода">
      <bpmn:incoming>F_g2_no</bpmn:incoming>
      <bpmn:outgoing>F_hint_show</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T_hshow" name="Показать подсказки исправления">
      <bpmn:incoming>F_hint_show</bpmn:incoming>
      <bpmn:outgoing>F_hshow_fix</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T_in"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_in" targetRef="T_send"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T_send" targetRef="T1"/>
    <bpmn:sequenceFlow id="F_T1_T2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F_T2_T3" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F_T3_T4" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F_T4_T5" sourceRef="T4" targetRef="T5"/>
    <bpmn:sequenceFlow id="F_T5_T6" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="F_T6_G1" sourceRef="T6" targetRef="G1"/>
    <bpmn:sequenceFlow id="F_yes" name="Да" sourceRef="G1" targetRef="T_show"/>
    <bpmn:sequenceFlow id="F_no" name="Нет" sourceRef="G1" targetRef="G2"/>
    <bpmn:sequenceFlow id="F_show_conf" sourceRef="T_show" targetRef="T_confirm"/>
    <bpmn:sequenceFlow id="F_conf_end" sourceRef="T_confirm" targetRef="E1"/>
    <bpmn:sequenceFlow id="F_g2_yes" name="Да" sourceRef="G2" targetRef="T_reco"/>
    <bpmn:sequenceFlow id="F_reco_cand" sourceRef="T_reco" targetRef="T_cand"/>
    <bpmn:sequenceFlow id="F_cand_fix" sourceRef="T_cand" targetRef="T_fix"/>
    <bpmn:sequenceFlow id="F_loop" name="Повторный запрос с новым описанием" sourceRef="T_fix" targetRef="T_in"/>
    <bpmn:sequenceFlow id="F_g2_no" name="Нет (не найдено)" sourceRef="G2" targetRef="T_hint"/>
    <bpmn:sequenceFlow id="F_hint_show" sourceRef="T_hint" targetRef="T_hshow"/>
    <bpmn:sequenceFlow id="F_hshow_fix" sourceRef="T_hshow" targetRef="T_fix"/>
  </bpmn:process>
  <bpmn:process id="P2" isExecutable="false">
    <bpmn:startEvent id="S2" name="Обновление КТРУ (расписание / вручную)">
      <bpmn:outgoing>G_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_1"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="E_load" name="Загрузить XML КТРУ из ЕИС (актуальная выгрузка)">
      <bpmn:incoming>G_1</bpmn:incoming>
      <bpmn:outgoing>G_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="E_filt" name="Отфильтровать: статус ACTIVE и категории (одежда, мебель, инструменты)">
      <bpmn:incoming>G_2</bpmn:incoming>
      <bpmn:outgoing>G_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="E_parse" name="Разобрать характеристики, значения, ОКЕИ; записать в SQLite">
      <bpmn:incoming>G_3</bpmn:incoming>
      <bpmn:outgoing>G_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="E_idx" name="Построить индекс (BM25, словарь опечаток) и опц. эмбеддинги e5-small">
      <bpmn:incoming>G_4</bpmn:incoming>
      <bpmn:outgoing>G_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Индекс опубликован (read-only)">
      <bpmn:incoming>G_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="G_1" sourceRef="S2" targetRef="E_load"/>
    <bpmn:sequenceFlow id="G_2" sourceRef="E_load" targetRef="E_filt"/>
    <bpmn:sequenceFlow id="G_3" sourceRef="E_filt" targetRef="E_parse"/>
    <bpmn:sequenceFlow id="G_4" sourceRef="E_parse" targetRef="E_idx"/>
    <bpmn:sequenceFlow id="G_5" sourceRef="E_idx" targetRef="E2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Part_1_di" bpmnElement="Part_1" isHorizontal="true"><dc:Bounds x="160" y="40" width="2080" height="540"/></bpmndi:BPMNShape>
