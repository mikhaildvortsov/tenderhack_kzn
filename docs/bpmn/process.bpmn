      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_cand_fix_di" bpmnElement="F_cand_fix">
        <di:waypoint x="1920" y="225"/>
        <di:waypoint x="1920" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_loop_di" bpmnElement="F_loop">
        <di:waypoint x="1920" y="75"/>
