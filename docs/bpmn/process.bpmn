        <di:waypoint x="370" y="58"/>
        <di:waypoint x="370" y="75"/>
        <bpmndi:BPMNLabel><dc:Bounds x="900" y="36" width="240" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g2_no_di" bpmnElement="F_g2_no">
        <di:waypoint x="1700" y="435"/>
